{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:schema:v1:transport:contracts:transport-terminal",
  "title": "TransportTerminal",
  "description": "One immutable channel terminal with legal origin/kind products only.",
  "x-agp": {
    "owner": "@agp/transport",
    "typescript": "TransportTerminal",
    "kind": "contract",
    "mechanics": "Defines the bounded transport-terminal value crossing the neutral transport boundary.",
    "rationale": "One schema and generated type prevent adapter-specific reinterpretation.",
    "consequence": "A divergent shape makes transport implementations observably incompatible.",
    "semanticRules": [
      "TRANSPORT-TERMINAL-ONCE-1"
    ]
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "origin": {
          "const": "local",
          "description": "Terminal authority origin."
        },
        "kind": {
          "type": "string",
          "enum": [
            "graceful",
            "aborted",
            "resource-exhausted"
          ],
          "description": "Terminal classification."
        },
        "diagnostic": {
          "$ref": "urn:agp:schema:v1:transport:contracts:transport-diagnostic",
          "description": "Optional bounded diagnostic."
        }
      },
      "required": [
        "origin",
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "origin": {
          "const": "remote",
          "description": "Terminal authority origin."
        },
        "kind": {
          "type": "string",
          "enum": [
            "graceful",
            "io-failure",
            "binding-violation"
          ],
          "description": "Terminal classification."
        },
        "diagnostic": {
          "$ref": "urn:agp:schema:v1:transport:contracts:transport-diagnostic",
          "description": "Optional bounded diagnostic."
        }
      },
      "required": [
        "origin",
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "origin": {
          "const": "carrier",
          "description": "Terminal authority origin."
        },
        "kind": {
          "type": "string",
          "enum": [
            "io-failure",
            "resource-exhausted",
            "binding-violation",
            "adapter-fault"
          ],
          "description": "Terminal classification."
        },
        "diagnostic": {
          "$ref": "urn:agp:schema:v1:transport:contracts:transport-diagnostic",
          "description": "Optional bounded diagnostic."
        }
      },
      "required": [
        "origin",
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
