{
  "name": "@agp/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./dist/schemas/*",
    "./semantic-rules/v1/*": "./dist/semantic-rules/v1/*"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "generate:check": "node scripts/generate-contracts.mjs --check",
    "build": "npm run generate:check && tsc -b",
    "test": "npm run build && node --test --test-concurrency=1 test/unit/*.test.js"
  },
  "dependencies": {
    "@agp/protocol": "0.1.0",
    "@agp/transport": "0.1.0",
    "ajv": "^8.17.1"
  }
}
