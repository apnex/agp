{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:schema:v1:core:configuration:reconnect-policy",
  "title": "AGP core reconnect-policy",
  "x-agp": {
    "owner": "@agp/core",
    "typescript": "ReconnectPolicy",
    "kind": "configuration",
    "mechanics": "Sovereign reconnect-policy data contract owned by @agp/core.",
    "rationale": "One schema gives runtime validators and consumers one stable reasoning boundary.",
    "consequence": "Accepting another shape would make canonical state or SDK interpretation ambiguous.",
    "semanticRules": []
  },
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "initialDelayMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumDelayMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "multiplier": {
      "type": "number",
      "minimum": 1,
      "maximum": 16
    },
    "jitterRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "initialDelayMs",
    "maximumDelayMs"
  ],
  "additionalProperties": false
}
