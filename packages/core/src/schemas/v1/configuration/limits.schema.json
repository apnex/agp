{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:schema:v1:core:configuration:limits",
  "title": "AGP core limits",
  "x-agp": {
    "owner": "@agp/core",
    "typescript": "Limits",
    "kind": "configuration",
    "mechanics": "Sovereign limits data contract owned by @agp/core.",
    "rationale": "One schema gives runtime validators and consumers one stable reasoning boundary.",
    "consequence": "Accepting another shape would make canonical state or SDK interpretation ambiguous.",
    "semanticRules": []
  },
  "type": "object",
  "properties": {
    "receiveLimitBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxRoutesPerSnapshot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxPathLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxHopCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxLocalEndpoints": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxCandidateRoutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [],
  "additionalProperties": false
}
