{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:schema:v1:core:operations:next-hop",
  "title": "AGP core next-hop",
  "x-agp": {
    "owner": "@agp/core",
    "typescript": "NextHop",
    "kind": "operations",
    "mechanics": "Sovereign next-hop data contract owned by @agp/core.",
    "rationale": "One schema gives runtime validators and consumers one stable reasoning boundary.",
    "consequence": "Accepting another shape would make canonical state or SDK interpretation ambiguous.",
    "semanticRules": []
  },
  "oneOf": [
