        "bindingId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "session"
        },
        "nodeId": {
          "$ref": "urn:agp:schema:v1:protocol:common:node-id"
        },
        "owningSessionId": {
          "$ref": "urn:agp:schema:v1:protocol:common:session-id"
        }
      },
      "required": [
        "kind",
        "nodeId",
        "owningSessionId"
      ],
      "additionalProperties": false
    }
  ]
