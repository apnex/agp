{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:schema:v1:core:operations:timer-snapshot",
  "title": "AGP core timer-snapshot",
  "x-agp": {
    "owner": "@agp/core",
    "typescript": "TimerSnapshot",
    "kind": "operations",
    "mechanics": "Sovereign timer-snapshot data contract owned by @agp/core.",
    "rationale": "One schema gives runtime validators and consumers one stable reasoning boundary.",
    "consequence": "Accepting another shape would make canonical state or SDK interpretation ambiguous.",
    "semanticRules": []
  },
  "type": "object",
  "properties": {
    "name": {
      "$ref": "urn:agp:schema:v1:core:codes:session-timer-name"
    },
    "state": {
      "type": "string",
      "enum": [
        "armed",
        "disabled"
      ]
    },
    "startedAt": {
      "$ref": "urn:agp:schema:v1:core:common:timestamp"
    },
    "durationMs": {
      "$ref": "urn:agp:schema:v1:core:common:duration-ms"
    },
    "expiresAt": {
      "$ref": "urn:agp:schema:v1:core:common:timestamp"
    },
    "remainingMs": {
      "$ref": "urn:agp:schema:v1:core:common:duration-ms"
    }
  },
  "required": [
    "name",
    "state"
  ],
  "additionalProperties": false
}
