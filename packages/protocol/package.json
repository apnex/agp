{
  "name": "@agp/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "AGP sovereign wire schemas, generated DTOs, codec, preflight checks, and contextual semantics.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/agp.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/apnex/agp#readme",
  "bugs": "https://github.com/apnex/agp/issues",
  "keywords": [
    "agp",
    "routing",
    "path-vector",
    "message-routing",
    "protocol"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/v1/*": "./dist/schemas/v1/*",
    "./semantic-rules/v1/*": "./dist/semantic-rules/v1/*"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "generate:check": "node scripts/generate-contracts.mjs --check",
    "build": "npm run generate:check && tsc -b",
    "test": "npm run build && node --test --test-concurrency=1 test/unit/*.test.js test/contract/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
