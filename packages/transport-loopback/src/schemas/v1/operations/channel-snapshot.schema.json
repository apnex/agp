        },
        "state": {
          "description": "Both endpoint terminals are committed.",
          "const": "Terminal"
        },
        "leftTerminal": {
          "description": "Connecting endpoint terminal.",
          "$ref": "urn:agp:schema:v1:transport:contracts:transport-terminal"
        },
        "rightTerminal": {
          "description": "Accepting endpoint terminal.",
          "$ref": "urn:agp:schema:v1:transport:contracts:transport-terminal"
        }
      },
      "required": [
        "channelId",
        "leftTransport",
        "rightTransport",
        "queuedPacketsLeft",
        "queuedBytesLeft",
        "queuedPacketsRight",
        "queuedBytesRight",
        "state",
        "leftTerminal",
        "rightTerminal"
      ],
      "additionalProperties": false
    }
  ]
}
