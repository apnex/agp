          "description": "Connecting transport, fixed at commit.",
          "$ref": "urn:agp:schema:v1:transport-loopback:common:transport-name"
        },
        "rightTransport": {
          "description": "Accepting transport, fixed at commit.",
          "$ref": "urn:agp:schema:v1:transport-loopback:common:transport-name"
        },
        "queuedPacketsLeft": {
          "description": "Packets queued for the connecting endpoint.",
          "type": "integer",
