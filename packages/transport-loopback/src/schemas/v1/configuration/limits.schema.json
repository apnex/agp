      "maximum": 9007199254740991
    },
    "maxListeners": {
      "description": "Hard fabric ceiling for maxListeners.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxPendingAcquisitions": {
      "description": "Hard fabric ceiling for maxPendingAcquisitions.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxActiveChannels": {
      "description": "Hard fabric ceiling for maxActiveChannels.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxPacketBytes": {
      "description": "Hard fabric ceiling for maxPacketBytes.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxBufferedPacketsPerChannel": {
      "description": "Hard fabric ceiling for maxBufferedPacketsPerChannel.",
      "type": "integer",
      "minimum": 1,
