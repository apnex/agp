  "required": [
    "maxTransports",
    "maxListeners",
    "maxPendingAcquisitions",
    "maxActiveChannels",
    "maxPacketBytes",
    "maxBufferedPacketsPerChannel",
    "maxBufferedBytesPerChannel",
