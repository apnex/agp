{
  "name": "@agp/management-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/v1/*": "./dist/schemas/v1/*"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "generate:check": "node scripts/generate-contracts.mjs --check",
    "build": "npm run generate:check && tsc -b",
    "test": "npm run build && node --test --test-concurrency=1 --test-reporter=spec test/unit/*.test.js test/contract/*.test.js",
    "test:unit": "npm run build && node --test --test-concurrency=1 --test-reporter=spec test/unit/*.test.js",
    "test:contract": "npm run build && node --test --test-concurrency=1 --test-reporter=spec test/contract/*.test.js"
  },
  "dependencies": {
    "@agp/core": "0.1.0",
    "ajv": "^8.17.1"
  }
}
