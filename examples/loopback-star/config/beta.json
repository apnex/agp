{
  "profile": "beta",
  "managementPort": 47212,
  "endpoints": [
    "billing/charge",
    "notifications/send",
    "shipping/quote",
    "shared/service"
  ],
  "nodeConfig": {
    "nodeId": "leaf.beta",
    "peers": [
      {
        "adjacencyId": "to-hub",
        "expectedNodeId": "hub",
        "transportRef": "loopback.hub",
        "reconnect": {
          "enabled": true,
          "initialDelayMs": 25,
          "maximumDelayMs": 250,
          "multiplier": 2,
          "jitterRatio": 0
        }
      }
    ],
    "transit": {
      "enabled": false,
      "defaultHopLimit": 16
    },
    "identityAdmission": {
      "mode": "allow"
    },
    "routeAdmission": {
      "mode": "allow"
    },
    "limits": {
      "maxLocalEndpoints": 16,
      "maxRoutesPerSnapshot": 256,
      "maxPathLength": 64,
      "maxHopCount": 16
    }
  },
  "transport": {
    "config": {
      "transportName": "beta",
      "capabilities": {
        "listen": false,
        "connect": true
      }
    },
    "listeners": [],
    "targets": [
      {
        "transportRef": "loopback.hub",
        "binding": {
          "fabricId": "agp-loopback-example",
          "address": "hub"
        }
      }
    ]
  }
}
