{
  "profile": "beta",
  "managementPort": 47112,
  "endpoints": [
    "billing/charge",
    "notifications/send",
    "shipping/quote",
    "shared/service"
  ],
  "transport": {
    "listeners": [],
    "targets": [
      {
        "transportRef": "ws.hub",
        "url": "ws://127.0.0.1:47100/agp",
        "compression": {
          "mode": "disabled"
        },
        "security": {
          "mode": "trusted-development"
        }
      }
    ]
  },
  "config": {
    "nodeId": "spoke.beta",
    "peers": [
      {
        "adjacencyId": "to-hub",
        "expectedNodeId": "hub",
        "transportRef": "ws.hub",
        "reconnect": {
          "enabled": true,
          "initialDelayMs": 250,
          "maximumDelayMs": 2000,
          "multiplier": 2,
          "jitterRatio": 0
        }
      }
    ],
    "transit": {
      "enabled": false,
      "defaultHopLimit": 16
    },
    "identityAdmission": {
      "mode": "allow"
    },
    "routeAdmission": {
      "mode": "allow"
    },
    "limits": {
      "maxLocalEndpoints": 16,
      "maxRoutesPerSnapshot": 256,
      "maxPathLength": 64,
      "maxHopCount": 16
    }
  }
}
